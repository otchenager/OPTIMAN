# Telegram-бот для заявок с сайта. На Vercel: Project → Settings → Environment Variables.
# Локально: скопируйте в .env (файл не коммитится).
TG_BOT_TOKEN=1234567890:AA_replace_with_new_token_from_BotFather
TG_CHAT_ID=000000000
# Необязательно: адрес API Telegram (для локального мока)
# TG_API_BASE=https://api.telegram.org
